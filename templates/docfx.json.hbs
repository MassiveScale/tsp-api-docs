{
  "build": {
    "content": [
      {
        "files": ["**/*.md", "**/toc.yml"],
        "exclude": ["_site/**"]
      }
    ],
    "resource": [],
    "globalMetadata": {
      "_enableSearch": true,
      "_appName": {{appName}},
      "_appTitle": {{appTitle}},
      "pdf": {{enablePdf}},
      "pdfTocPage": {{enablePdfTocPage}}
    },
    "template": [{{#each themes}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}],
    "dest": "_site"
  }
}
